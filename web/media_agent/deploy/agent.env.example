# Nimrod media agent — service config. Copy to a real file and edit the values.
#   Linux (Pi):  /etc/nimrod/agent.env   (install-linux.sh writes this for you)
#   Windows:     agent.env  next to run-agent.ps1
#
# The agent reads these; CLI args (--root/--port/--origin) still override them.

# The folder that holds your photos/videos (an external drive is fine):
NIMROD_MEDIA_ROOT=/home/pi/nimrod-media

# Bind address. 127.0.0.1 = localhost only, the safe default: use it whenever the
# dashboard runs on THIS machine. The agent has no authentication, so binding all
# interfaces (0.0.0.0) on a shared network lets anyone on it download your media.
# Only widen this if the dashboard runs on a DIFFERENT device, and prefer a
# private/tailnet address over 0.0.0.0.
NIMROD_MEDIA_HOST=127.0.0.1

# Port the agent listens on (the dashboard fetches media from http://localhost:PORT):
NIMROD_MEDIA_PORT=8770

# CORS: lock this to YOUR dashboard origin. Use * only for local testing.
NIMROD_MEDIA_ORIGIN=https://bedside.nimrodecosystem.com
