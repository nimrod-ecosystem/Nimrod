[Unit]
Description=Nimrod local media agent — serves your photos/videos to your dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# THIS FILE IS A REFERENCE COPY, NOT THE ONE THAT RUNS. install-linux.sh writes its
# own unit with the python path, the agent.py path and YOUR login name filled in from
# `SUDO_USER`, so it never reads this. Only edit this one if you are installing by hand
# — and if you are, the three values below are the three you must change.
#
# `User=` MUST be a login that exists on this machine and can read your media folder.
# It used to carry one developer's own username, which was both a personal detail in a
# public repository and a default that could only ever work on one machine.
EnvironmentFile=/etc/nimrod/agent.env
ExecStart=/usr/bin/python3 /opt/nimrod/web/media_agent/agent.py
Restart=always
RestartSec=3
User=CHANGE_ME_TO_YOUR_LOGIN_NAME

[Install]
WantedBy=multi-user.target
