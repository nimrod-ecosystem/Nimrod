{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nimrodecosystem.com/schema/nimrod.research.v1.json",
  "title": "nimrod.research.v1",
  "description": "One research pack: facts, quotes or words, researched once and read by every module (web/client/research_index.js). The columns marked (GN) were added 2026-11-24 and are all optional, so a pack written before them is still valid. web/tools/research_check.py checks a pack against this file; keep the two in step (web/tools/test_research_check.py fails when they differ).",
  "type": "object",
  "required": ["schema", "items"],
  "properties": {
    "schema": { "const": "nimrod.research.v1" },
    "kind": { "type": "string", "description": "What the pack mostly holds: fact, quote or word." },
    "name": { "type": "string", "maxLength": 120 },
    "language": { "$ref": "#/$defs/language", "description": "(GN) The pack's language; an item may say its own. \"en\" when neither says." },
    "items": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "language": { "type": "string", "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$" },
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "licence": { "type": "string", "description": "Kept on the source, not the item: a CC BY source is credited with it." }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "kind", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": { "enum": ["fact", "quote", "word"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "status": { "enum": ["unverified", "verified", "flagged", "disputed"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "difficulty": { "type": "string", "description": "very easy, easy, medium or hard. Read as a level when `level` is absent." },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "ai_written": { "type": "boolean" },
        "topic": { "type": "string", "description": "fact" },
        "note": { "type": "string", "description": "fact" },
        "speaker": { "type": "string", "description": "quote: required for a quote" },
        "work": { "type": "string", "description": "quote" },
        "year": { "type": ["string", "integer"], "description": "quote" },
        "context": { "type": "string", "description": "quote" },
        "word": { "type": "string", "description": "word" },
        "part_of_speech": { "type": "string", "description": "word" },
        "definition": { "type": "string", "description": "word" },
        "example": { "type": "string", "description": "word" },
        "aac_core": { "type": "boolean", "description": "word" },
        "check": { "type": "object", "description": "the second pass's finding" },
        "from": {
          "type": "object",
          "required": ["course"],
          "description": "The lesson an item was pulled out of (2026-11-23).",
          "properties": {
            "course": { "type": "string", "minLength": 1 },
            "class": { "type": "integer", "minimum": 1 },
            "lesson": { "type": "string" }
          }
        },
        "level": { "type": "integer", "minimum": 1, "maximum": 6, "description": "(GN) 1 everyday to 6 rare, for every kind." },
        "content": {
          "type": "array",
          "items": { "enum": ["slur", "swear", "sexual", "adult"] },
          "description": "(GN) What a screen may hold back (web/client/word_filter.js): adult = drugs, weapons or violence. Read with the screen's \"Words the games may use\". Illness, the body and death are none of these."
        },
        "related": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 20, "description": "(GN) Ids of other items." },
        "true_as_of": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$", "description": "(GN) For a fact that can change: when it was true." },
        "symbol": { "type": "string", "description": "(GN) An AAC symbol id, when the pack has one." },
        "language": { "$ref": "#/$defs/language", "description": "(GN) The item's own language, when not the pack's." }
      }
    }
  }
}
