[Unit]
Description=Nimrod fallback media agent - serves this computer's own copy of the pictures (read-only, this computer only), for "Backup folder for this screen"
Documentation=file:%h/.local/bin/nimrod-media-agent.py

[Service]
Type=simple
# The folder, port and address are in this file, not here (install-linux.sh NIMROD_FALLBACK=1 writes it, and keeps an
# existing one): NIMROD_MEDIA_ROOT (the folder the "fallback" copy job fills), NIMROD_MEDIA_PORT (default 8771, beside
# the drive's agent on 8770), NIMROD_MEDIA_HOST (127.0.0.1: only this screen needs its backup).
# No NIMROD_MEDIA_DATA on purpose: history is written by the drive's agent; two agents appending it would double it.
EnvironmentFile=%h/.config/nimrod/fallback-agent.env
ExecStart=/usr/bin/python3 %h/.local/bin/nimrod-media-agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
