# ============================================================
#  PRIVACY FIRST — never commit patient data or personal media
#  (These patterns are a safety net, not a substitute for care.)
# ============================================================
# Patient / personal media and data
**/photos/
**/media/
**/recordings/
**/clinical/
*.mov
*.mp4
*.wav
*.m4a
*.jpg
*.jpeg
*.png
*.heic
# Allow intentional, non-sensitive UI/asset images by un-ignoring a known folder:
!web/assets/ui/**

# Secrets & local config
.env
.env.*
*.local
config.local.*
secrets.*
*.key
*.pem

# Node
node_modules/
dist/
build/
.cache/
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Server-local database (per-user state lives here at runtime; never committed)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local personal household material. Keep it OUT of this public repo — move it to
# the private repo if it ever needs versioning. See docs/points-sheet.md for the
# non-personal parts (the sheet LAYOUT) that are safe to publish.
household-kit/
*.xlsx

# Working notes live in the PRIVATE monorepo (Nimrod_Ecosystem), never here.
# A stray `cd` into this repo once appended session flags to a file of this name and
# it got committed. Belt and braces.
pending_flags.md
handoffs/
CONTEXT.md

# Recorder output. A video is a big binary and DECISIONS.md is explicit that one does not go
# into the tree by reflex - the hosting answer is a GitHub release asset, the same one already
# reached for the model files. The timings.json beside it is regenerated by every run.
web/tools/walkthrough_out/
*.webm
